{
	"commands": {
		"move":        { "label": "Move",   "color": "4fc3f7" },
		"attack_move": { "label": "A-Move", "color": "ef5350" },
		"patrol":      { "label": "Patrol", "color": "ba68c8" },
		"stop":        { "label": "Stop",   "color": "ffb74d", "targeted": false },
		"hold":        { "label": "Hold",   "color": "90a4ae", "targeted": false },
		"attack":      { "label": "Attack", "color": "e53935" }
	},
	"side_buttons": [
		{
			"id": "movement",
			"default_command": "move",
			"radial": {
				"up": "attack_move",
				"right": "patrol",
				"down": "stop",
				"left": "hold"
			}
		},
		{
			"id": "abilities",
			"default_command": "attack",
			"radial": {},
			"selection_abilities": true
		}
	],
	"context_orders": {
		"ground": "move",
		"enemy": "attack",
		"resource": "move"
	},
	"reselect": {
		"label": "Re",
		"hold_time": 0.5
	},
	"hud": {
		"alloy": "Alloy",
		"flux": "Flux",
		"bandwidth": "Bandwidth"
	},
	"console": {
		"tabs": [
			{ "id": "build",    "label": "Build",    "screen": "build" },
			{ "id": "train",    "label": "Train",    "screen": "build_train" },
			{ "id": "strategy", "label": "Strategy", "screen": "strategy" },
			{ "id": "tactics",  "label": "Tactics",  "screen": "tactics" },
			{ "id": "economy",  "label": "Economy",  "screen": "economy" },
			{ "id": "organize", "label": "Organize", "screen": "organize" },
			{ "id": "world",    "label": "World",    "screen": "world" }
		],
		"screens": {
			"build": {
				"title": "Build",
				"widgets": [
					{ "type": "structure_grid", "params": { "placement_screen": "build_place" } }
				]
			},
			"build_place": {
				"title": "Placement",
				"widgets": [
					{ "type": "label", "label": "Tap a pin to auto-place near it, tap the minimap to place precisely there — or swipe the console down and tap the world directly." },
					{ "type": "minimap", "params": { "mode": "pick" } }
				]
			},
			"build_train": {
				"title": "Training",
				"widgets": [
					{ "type": "unit_grid" },
					{ "type": "queue_strip" }
				]
			},
			"strategy": {
				"title": "Strategy",
				"widgets": [
					{ "type": "label", "label": "Standing orders for designated groups land in M4." }
				]
			},
			"tactics": {
				"title": "Tactics",
				"widgets": [
					{ "type": "label", "label": "Stances and priorities land with unit AI (M4)." }
				]
			},
			"economy": {
				"title": "Economy",
				"widgets": [
					{ "type": "alloc_sliders" }
				]
			},
			"organize": {
				"title": "Organize",
				"widgets": [
					{ "type": "group_roster" }
				]
			},
			"world": {
				"title": "World",
				"widgets": [
					{ "type": "minimap", "params": { "mode": "jump" } },
					{ "type": "label", "label": "Heatmaps and overlays land later; tap to jump the camera." }
				]
			}
		}
	}
