# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Exports
*.apk
*.apk.idsig

# Native sim (GDExtension) build artifacts — the .gdextension manifest in
# bin/ is committed; the compiled libraries and SCons intermediates are not.
bin/*.so
bin/*.dll
bin/*.dylib
bin/*.wasm
native/**/*.o
native/**/*.os
native/**/*.obj
native/.sconsign.dblite
native/**/.sconsign.dblite