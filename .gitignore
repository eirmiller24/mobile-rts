# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Exports
*.apk
*.apk.idsig

# Native sim (GDExtension) build artifacts — the .gdextension manifest in
# bin/ is committed; the compiled libraries and SCons intermediates are not.
bin/*.so
bin/*.dll
bin/*.dylib
bin/*.wasm
native/**/*.o
native/**/*.os
native/**/*.obj
native/.sconsign.dblite
native/**/.sconsign.dblite
# Scratch renders from tools/preview_unit.gd
.preview/

# Blender scratch. `.blenderwork/` is rig/pose/viewport reference renders and
# `*.blend1` is Blender's autosave of the previous save — both are regenerable
# and neither is an input to `make models`. Keeping them out matters more than
# usual now that binary assets go through LFS: committing derived binaries is
# what makes a game repo's history grow without bound.
.blenderwork/
*.blend1

# Python bytecode (tools/blender/)
__pycache__/
*.pyc
